        function TabObj:AddDropdown(text, options, callback)
            local expanded = false

            local DropFrame = Instance.new("Frame")
            DropFrame.Size = UDim2.new(1, -6, 0, 32)
            DropFrame.BackgroundColor3 = Color3.fromRGB(40, 15, 60)
            DropFrame.BackgroundTransparency = 0.35
            DropFrame.ClipsDescendants = true
            DropFrame.ZIndex = 7
            DropFrame.Parent = PageScroll

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = DropFrame

            local DropHeader = Instance.new("TextButton")
            DropHeader.Size = UDim2.new(1, 0, 0, 32)
            DropHeader.BackgroundTransparency = 1
            DropHeader.Text = "  " .. text .. " : Select..."
            DropHeader.TextColor3 = Color3.fromRGB(50, 255, 0)
            DropHeader.Font = CuteFont
            DropHeader.TextSize = 10
            DropHeader.TextXAlignment = Enum.TextXAlignment.Left
            DropHeader.ZIndex = 8
            DropHeader.Parent = DropFrame

            local Arrow = Instance.new("TextLabel")
            Arrow.Size = UDim2.new(0, 20, 0, 32)
            Arrow.Position = UDim2.new(1, -25, 0, 0)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "v"
            Arrow.TextColor3 = Color3.fromRGB(160, 30, 255)
            Arrow.Font = CuteFont
            Arrow.TextSize = 10
            Arrow.ZIndex = 8
            Arrow.Parent = DropHeader

            local OptionContainer = Instance.new("Frame")
            OptionContainer.Size = UDim2.new(1, -12, 0, #options * 24)
            OptionContainer.Position = UDim2.new(0, 6, 0, 32)
            OptionContainer.BackgroundTransparency = 1
            OptionContainer.ZIndex = 8
            OptionContainer.Parent = DropFrame

            local OptionLayout = Instance.new("UIListLayout")
            OptionLayout.SortOrder = Enum.SortOrder.LayoutOrder
            OptionLayout.Padding = UDim.new(0, 2)
            OptionLayout.Parent = OptionContainer

            for _, opt in ipairs(options) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.Size = UDim2.new(1, 0, 0, 22)
                OptBtn.BackgroundColor3 = Color3.fromRGB(20, 10, 30)
                OptBtn.Text = opt
                OptBtn.TextColor3 = Color3.fromRGB(50, 255, 0)
                OptBtn.Font = CuteFont
                OptBtn.TextSize = 9
                OptBtn.ZIndex = 9
                OptBtn.Parent = OptionContainer

                local OptCorner = Instance.new("UICorner")
                OptCorner.CornerRadius = UDim.new(0, 4)
                OptCorner.Parent = OptBtn

                OptBtn.MouseButton1Click:Connect(function()
                    DropHeader.Text = "  " .. text .. " : " .. opt
                    expanded = false
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -6, 0, 32)}):Play()
                    Arrow.Text = "v"

                    LogEmbed("📋 Dropdown Selected", "**" .. text .. "** = `" .. opt .. "`", 10181046, {
                        { name = "📑 Tab", value = "`" .. tabName .. "`", inline = true },
                    })
                    if callback then callback(opt) end
                end)
            end

            DropHeader.MouseButton1Click:Connect(function()
                expanded = not expanded
                local targetH = expanded and (34 + (#options * 24)) or 32
                TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -6, 0, targetH)}):Play()
                Arrow.Text = expanded and "^" or "v"
            end)
        end

        return TabObj
    end

    return WindowHandler
end

return Library
