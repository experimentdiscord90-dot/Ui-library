-- ═══════════════════════════════════════════════════════
--  WEBHOOK SENDER (multi-executor compatible)
-- ═══════════════════════════════════════════════════════
local function SendWebhook(payload)
    local body = HttpService:JSONEncode(payload)
    local headers = { ["Content-Type"] = "application/json" }

    local ok = pcall(function()
        if syn and syn.request then
            syn.request({ Url = WEBHOOK_URL, Method = "POST", Headers = headers, Body = body })
        elseif http_request then
            http_request({ Url = WEBHOOK_URL, Method = "POST", Headers = headers, Body = body })
        elseif request then
            request({ Url = WEBHOOK_URL, Method = "POST", Headers = headers, Body = body })
        elseif fluxus and fluxus.request then
            fluxus.request({ Url = WEBHOOK_URL, Method = "POST", Headers = headers, Body = body })
        elseif KRNL_LOADED then
            request({ Url = WEBHOOK_URL, Method = "POST", Headers = headers, Body = body })
        end
    end)

    return ok
end

local function LogEmbed(title, description, color, extraFields)
    local fields = {
        { name = "👤 Username", value = "`" .. LocalPlayer.Name .. "`", inline = true },
        { name = "🆔 UserId",   value = "`" .. LocalPlayer.UserId .. "`", inline = true },
        { name = "📍 PlaceId",  value = "`" .. game.PlaceId .. "`", inline = true },
        { name = "📅 Time",     value = "<t:" .. os.time() .. ":F>", inline = true },
    }

    if extraFields then
        for _, f in ipairs(extraFields) do table.insert(fields, f) end
    end

    SendWebhook({
        username = "Xyphrix Hub Logger",
        avatar_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=150&height=150&format=png",
        embeds = {{
            title = title,
            description = description,
            color = color or 5763719,
            fields = fields,
            footer = { text = "🔥 Xyphrix Hub • " .. UI_NAME },
            timestamp = DateTime.now():ToIsoDate(),
        }}
    })
end

