    -- RIGHT SHIFT
    --------------------------------------------------------

    UserInputService.InputBegan:Connect(
        function(input, processed)

            if processed then
                return
            end

            if
                input.KeyCode
                == Enum.KeyCode.RightShift
            then

                Window:Toggle()
            end
        end
    )

    --------------------------------------------------------
    -- RESPONSIVE
    --------------------------------------------------------

    local function Resize()

        if Window.Destroyed then
            return
        end

        OriginalSize =
            GetSize()

        if Window.Visible then
            Main.Size =
                OriginalSize
        end

        Shadow.Size =
            UDim2.fromOffset(
                OriginalSize.X.Offset + 28,
                OriginalSize.Y.Offset + 28
            )
    end

    if workspace.CurrentCamera then

        workspace.CurrentCamera
            :GetPropertyChangedSignal(
                "ViewportSize"
            )
            :Connect(Resize)
    end

