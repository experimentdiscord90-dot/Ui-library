    --------------------------------------------------------
    -- DESTROY
    --------------------------------------------------------

    function Window:Destroy()

        if Window.Destroyed then
            return
        end

        Window.Destroyed = true

        if Gui then
            Gui:Destroy()
        end

        for Index, Item in ipairs(
            XYPHRIX.Windows
        ) do

            if Item == Window then

                table.remove(
                    XYPHRIX.Windows,
                    Index
                )

                break
            end
        end
    end

    --------------------------------------------------------
    -- REGISTER
    --------------------------------------------------------

    table.insert(
        XYPHRIX.Windows,
        Window
    )

    return Window
end

------------------------------------------------------------
-- GLOBAL THEME
------------------------------------------------------------

function XYPHRIX:SetTheme(name)

    for _, Window in ipairs(
        XYPHRIX.Windows
    ) do

        if not Window.Destroyed then
            Window:SetTheme(name)
        end
    end
end

------------------------------------------------------------
-- GLOBAL DESTROY
------------------------------------------------------------

function XYPHRIX:Destroy()

    for _, Window in ipairs(
        XYPHRIX.Windows
    ) do

        pcall(function()
            Window:Destroy()
        end)
    end

    table.clear(
        XYPHRIX.Windows
    )
end

