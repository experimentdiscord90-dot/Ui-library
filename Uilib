                    Theme.Text
            end
        )

        UserInputService.InputBegan:Connect(
            function(
                input,
                processed
            )

                if processed then
                    return
                end

                if Listening then

                    if
                        input.KeyCode
                        ~= Enum.KeyCode.Unknown
                    then

                        Key =
                            input.KeyCode

                        Listening = false

                        KeyBox.Text =
                            Key.Name

                        KeyBox.TextColor3 =
                            Theme.Accent
                    end

                    return
                end

                if
                    input.KeyCode
                    == Key
                then

                    Safe(callback)
                end
            end
        )

        return {
            Set = function(_, newKey)

                if
                    typeof(newKey)
                    == "EnumItem"
                then

                    Key = newKey

                    KeyBox.Text =
                        Key.Name
                end
            end,

            Get = function()
                return Key
            end,

            Destroy = function()
                Button:Destroy()
            end,
        }
    end

