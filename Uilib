--========================================================
-- SHOW / HIDE
--========================================================

local IsAnimating = false

function Lib:Hide()
	if IsAnimating or not Main.Visible then
		return
	end

	IsAnimating = true

	Tween(Main, 0.22, {
		Size = UDim2.fromOffset(0, 0),
	})

	task.delay(0.23, function()
		if not Main.Parent then
			return
		end

		Main.Visible = false
		OpenButton.Visible = true

		IsAnimating = false
	end)
end

function Lib:Show()
	if IsAnimating then
		return
	end

	IsAnimating = true

	OpenButton.Visible = false

	UpdateWindowSize()

	Main.Visible = true
	Main.Size = UDim2.fromOffset(0, 0)

	local targetWidth = 280
	local targetHeight = 380

	local camera = workspace.CurrentCamera

	if camera then
		local viewport = camera.ViewportSize

		if viewport.X < targetWidth + 20 then
			targetWidth = math.max(240, viewport.X - 20)
		end

		if viewport.Y < targetHeight + 20 then
			targetHeight = math.max(300, viewport.Y - 20)
		end
	end

	local tween = Tween(
		Main,
		0.28,
		{
			Size = UDim2.fromOffset(
				targetWidth,
				targetHeight
			),
		}
	)

	if tween then
		tween.Completed:Connect(function()
			IsAnimating = false
			ClampMainToScreen()
		end)
	else
		IsAnimating = false
	end
end

function Lib:Destroy()
	DisconnectAll()

	if Gui then
		Gui:Destroy()
	end

	table.clear(ThemeRegistry)
	table.clear(PagesData)
	table.clear(Lib.Windows)
end

Connect(Close.Activated, function()
	Lib:Hide()
end)

Connect(OpenButton.Activated, function()
	Lib:Show()
end)

--========================================================
-- RIGHT SHIFT
--========================================================

Connect(UserInputService.InputBegan, function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		if Main.Visible then
			Lib:Hide()
		else
			Lib:Show()
		end
	end
end)

--========================================================
-- THEME
--========================================================

function Lib:SetTheme(themeName)
	if not Lib.Themes[themeName] then
		return false
	end

	Lib.CurrentTheme = themeName
	C = Lib.Themes[themeName]

	ApplyTheme()

	UpdateBorderGradient()
	UpdateOpenGradient()

	-- Refresh UI elements that directly use the current theme.
	for _, data in ipairs(PagesData) do
		if data.TabLabel then
			if data.Page.Visible then
				data.TabLabel.TextColor3 = C.Text
			else
				data.TabLabel.TextColor3 = C.Muted
			end
		end

		if data.Indicator then
			data.Indicator.BackgroundColor3 = C.Accent
		end
	end

	Lib:Notify(
		"Theme Changed",
		"Applied " .. tostring(themeName),
		2
	)

	return true
end

--========================================================
-- WINDOW
--========================================================

function Lib:CreateWindow(name, subtitle)
	TitleText.Text = name or "XYPHRIX HUB"

	-- subtitle is intentionally preserved for API compatibility.
	-- v7.1 did not render it, so it remains unused.

	Lib:Show()

	return Lib
end

--========================================================
-- RETURN
--========================================================

return Lib
