    --------------------------------------------------------

    local OriginalSize =
        Main.Size

    local function Show()

        if Window.Destroyed then
            return
        end

        Window.Visible = true

        Main.Visible = true

        OpenButton.Visible = false

        UIScale.Scale = 0.94

        Shadow.BackgroundTransparency =
            1

        Tween(
            UIScale,
            0.24,
            {
                Scale = 1
            },
            Enum.EasingStyle.Back
        )

        Tween(
            Shadow,
            0.22,
            {
                BackgroundTransparency =
                    0.45
            }
        )
    end

    local function Hide()

        if Window.Destroyed then
            return
        end

        Window.Visible = false

        Tween(
            UIScale,
            0.18,
            {
                Scale = 0.94
            }
        )

        Tween(
            Shadow,
            0.18,
            {
                BackgroundTransparency =
                    1
            }
        )

        task.delay(
            0.19,
            function()

                if
                    not Window.Visible
                    and Main.Parent
                then

                    Main.Visible = false
                    OpenButton.Visible = true
                end
            end
        )
    end

    function Window:SetVisible(value)

        if value then
            Show()
        else
            Hide()
        end
    end

    function Window:Show()
        Show()
    end

    function Window:Hide()
        Hide()
    end

    function Window:Toggle()
        if Window.Visible then
            Hide()
        else
            Show()
        end
    end

