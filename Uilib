    --------------------------------------------------------
    -- SELECT TAB
    --------------------------------------------------------

    local CurrentTab

    local function SelectTab(tabName)

        for name, data in pairs(
            Window.Pages
        ) do

            data.Frame.Visible =
                name == tabName

            if name == tabName then
                data.Frame.CanvasPosition =
                    Vector2.new(0, 0)
            end
        end

        for _, child in ipairs(
            TabScroll:GetChildren()
        ) do

            if child:IsA("TextButton") then

                local selected =
                    child.Name == tabName

                Tween(
                    child,
                    0.18,
                    {
                        BackgroundColor3 =
                            selected
                            and Theme.Accent
                            or Theme.Surface2,

                        TextColor3 =
                            selected
                            and Color3.new(
                                1,
                                1,
                                1
                            )
                            or Theme.Muted,
                    },
                    Enum.EasingStyle.Quint
                )
            end
        end

        CurrentTab = tabName
    end

