        )

        Stroke(
            Frame,
            Theme.Border,
            1
        )

        local Label = New("TextLabel", {
            BackgroundTransparency = 1,

            Position = UDim2.fromOffset(
                13,
                7
            ),

            Size = UDim2.new(
                0.65,
                0,
                0,
                18
            ),

            Text = text or "Slider",

            Font = Config.Font,

            TextSize = 10,

            TextColor3 =
                Theme.Text,

            TextXAlignment =
                Enum.TextXAlignment.Left,

            ZIndex = 13,
        })

        Label.Parent = Frame

        local ValueLabel = New("TextLabel", {
            BackgroundTransparency = 1,

            Position = UDim2.new(
                1,
                -65,
                0,
                7
            ),

            Size = UDim2.fromOffset(
                52,
                18
            ),

            TextColor3 =
                Theme.Accent,

            Font = Config.Bold,

            TextSize = 9,

            TextXAlignment =
                Enum.TextXAlignment.Right,

            ZIndex = 13,
        })

        ValueLabel.Parent = Frame

        local Bar = New("Frame", {
            BackgroundColor3 =
                Theme.Surface2,

            Position = UDim2.new(
                0,
                13,
                1,
                -18
            ),

            Size = UDim2.new(
                1,
                -26,
                0,
                6
            ),

            BorderSizePixel = 0,

            ZIndex = 13,
        })

        Bar.Parent = Frame

        Corner(Bar, 99)

        local Fill = New("Frame", {
            BackgroundColor3 =
                Theme.Accent,

            Size = UDim2.fromScale(
                0,
                1
            ),

            BorderSizePixel = 0,

            ZIndex = 14,
        })

        Fill.Parent = Bar

        Corner(Fill, 99)

        Gradient(
            Fill,
            {
                Theme.Accent,
                Theme.Accent2,
                Theme.Accent
            },
            0
        )

        local Knob = New("Frame", {
            BackgroundColor3 =
                Color3.new(
                    1,
                    1,
                    1
                ),

            AnchorPoint =
                Vector2.new(
                    0.5,
                    0.5
                ),

            Size = UDim2.fromOffset(
                12,
                12
            ),

            BorderSizePixel = 0,

            ZIndex = 15,
        })

        Knob.Parent = Bar

        Corner(Knob, 99)

        local Dragging = false

        local function SetValue(
            value,
            fire
        )

            Value =
                math.clamp(
                    value,
                    min,
                    max
                )

            local Alpha = 0

            if max ~= min then
                Alpha =
                    (Value - min)
                    / (max - min)
            end

            Fill.Size =
                UDim2.new(
                    Alpha,
                    0,
                    1,
                    0
                )

            Knob.Position =
                UDim2.new(
                    Alpha,
                    0,
                    0.5,
                    0
                )

            ValueLabel.Text =
                tostring(
                    math.floor(
                        Value * 100
                    ) / 100
                )

            if fire then
                Safe(
                    callback,
                    Value
                )
            end
        end

        local function InputValue(
            input
        )

            local width =
                math.max(
                    Bar.AbsoluteSize.X,
                    1
                )

            local x =
                input.Position.X
                - Bar.AbsolutePosition.X

            local Alpha =
                math.clamp(
                    x / width,
                    0,
                    1
                )

            SetValue(
                min +
                (
                    max - min
                ) * Alpha,
                true
            )
        end

        Bar.InputBegan:Connect(
            function(input)

                if
                    input.UserInputType
                    == Enum.UserInputType.MouseButton1
                    or
                    input.UserInputType
                    == Enum.UserInputType.Touch
                then

                    Dragging = true
                    InputValue(input)
                end
            end
        )

        UserInputService.InputChanged:Connect(
            function(input)

                if not Dragging then
                    return
                end

                if
                    input.UserInputType
                    == Enum.UserInputType.MouseMovement
                    or
                    input.UserInputType
                    == Enum.UserInputType.Touch
                then

                    InputValue(input)
                end
            end
        )

        UserInputService.InputEnded:Connect(
            function(input)

                if
                    input.UserInputType
                    == Enum.UserInputType.MouseButton1
                    or
                    input.UserInputType
                    == Enum.UserInputType.Touch
                then

                    Dragging = false
                end
            end
        )

        SetValue(Value, false)

        return {
            Set = function(_, value)
                SetValue(
                    tonumber(value)
                    or min,
                    true
                )
            end,

            Get = function()
                return Value
            end,

            Destroy = function()
                Frame:Destroy()
            end,
        }
    end

