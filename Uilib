local PagesData = {}

local function SelectPage(data)
	for _, item in ipairs(PagesData) do
		item.Page.Visible = false

		Tween(item.Tab, 0.15, {
			BackgroundTransparency = 1,
		})

		Tween(item.TabLabel, 0.15, {
			TextColor3 = C.Muted,
		})

		Tween(item.Indicator, 0.15, {
			BackgroundTransparency = 1,
		})
	end

	data.Page.Visible = true

	Tween(data.Tab, 0.15, {
		BackgroundColor3 = C.Accent,
		BackgroundTransparency = 0.85,
	})

	Tween(data.TabLabel, 0.15, {
		TextColor3 = C.Text,
	})

	Tween(data.Indicator, 0.15, {
		BackgroundTransparency = 0,
	})
end

function Lib:CreatePage(name, icon)
	name = tostring(name or "Page")
	icon = tostring(icon or "")

	local page = New("ScrollingFrame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,

		ScrollBarThickness = 2,
		ScrollBarImageColor3 = C.Accent,
		ScrollBarImageTransparency = 0.15,

		CanvasSize = UDim2.new(0, 0, 0, 0),

		ScrollingDirection = Enum.ScrollingDirection.Y,

		-- IMPORTANT:
		-- Roblox handles touch/mouse scrolling natively.
		ScrollingEnabled = true,

		AutomaticCanvasSize = Enum.AutomaticSize.None,

		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,

		ClipsDescendants = true,
		Visible = false,

		ZIndex = 6,
	}, Pages)

	RegisterThemeObject(page, "ScrollBarImageColor3", "Accent")

	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.Parent = page

	local layout = New("UIListLayout", {
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, page)

	-- Reliable canvas calculation.
	local function UpdateCanvas()
		if not page.Parent then
			return
		end

		local contentHeight = layout.AbsoluteContentSize.Y

		page.CanvasSize = UDim2.fromOffset(
			0,
			math.max(
				contentHeight + 30,
				page.AbsoluteSize.Y + 1
			)
		)
	end

	Connect(
		layout:GetPropertyChangedSignal("AbsoluteContentSize"),
		UpdateCanvas
	)

	Connect(
		page:GetPropertyChangedSignal("AbsoluteSize"),
		UpdateCanvas
	)

	task.defer(UpdateCanvas)

	-- TAB
	local tab = New("TextButton", {
		Size = UDim2.new(0, 80, 1, -6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Active = true,
		ZIndex = 20,
	}, TabNav)

	Round(tab, 6)

	local indicator = ThemeColor(
		"Frame",
		{
			Size = UDim2.new(1, 0, 0, 2),
			Position = UDim2.new(0, 0, 1, -2),
			BackgroundColor3 = C.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 22,
		},
		tab,
		"BackgroundColor3",
		"Accent"
	)

	local tabLabel = ThemeColor(
		"TextLabel",
		{
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = icon .. (#icon > 0 and " " or "") .. name,
			TextColor3 = C.Muted,
			TextSize = 9,
			Font = Enum.Font.GothamMedium,
			TextWrapped = true,
			ZIndex = 21,
		},
		tab,
		"TextColor3",
		"Muted"
	)

	local data = {
		Name = name,
		Page = page,
		Tab = tab,
		TabLabel = tabLabel,
		Indicator = indicator,
	}

	table.insert(PagesData, data)

	-- Auto fit tabs
	local count = #PagesData

	for _, d in ipairs(PagesData) do
		d.Tab.Size = UDim2.new(
			1 / count,
			-4,
			1,
			-6
		)
	end

	Connect(tab.Activated, function()
		SelectPage(data)
	end)

	if count == 1 then
		SelectPage(data)
	end

	return page, data
end

