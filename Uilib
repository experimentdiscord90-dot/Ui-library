        Brand.BackgroundColor3 =
            Theme.Surface2

        BrandStroke.Color =
            Theme.Border

        Title.TextColor3 =
            Theme.Text

        Subtitle.TextColor3 =
            Theme.Muted

        Close.BackgroundColor3 =
            Theme.Surface2

        Close.TextColor3 =
            Theme.Muted

        CloseStroke.Color =
            Theme.Border

        Divider.BackgroundColor3 =
            Theme.Border

        TabHolder.BackgroundColor3 =
            Theme.Surface

        OpenButton.BackgroundColor3 =
            Theme.Surface

        OpenButton.TextColor3 =
