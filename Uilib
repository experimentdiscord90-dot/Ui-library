		else
			Tween(switch, 0.15, {
				BackgroundColor3 = Color3.fromRGB(40, 50, 80),
			})

			Tween(knob, 0.15, {
				Position = UDim2.fromOffset(3, 3),
				BackgroundColor3 = C.Muted,
			})
		end
	end

	Connect(button.Activated, function()
		enabled = not enabled

		Update()

		SafeCallback(callback, enabled)
	end)

	Update()

	return {
		Object = button,

		Set = function(self, value)
			if type(self) == "boolean" then
				value = self
			end

			enabled = value == true

			Update()
		end,

		Get = function()
			return enabled
		end,
	}
end

