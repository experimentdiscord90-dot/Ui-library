-- RESPONSIVE SIZE
------------------------------------------------------------

local function GetSize()
    local camera = workspace.CurrentCamera

    if not camera then
        return UDim2.fromOffset(
            Config.Width,
            Config.Height
        )
    end

    local viewport = camera.ViewportSize

    local width = Config.Width
    local height = Config.Height

    if viewport.X <= 330 then
        width = math.max(
            Config.MinWidth,
            viewport.X - 18
        )

        height = math.clamp(
            viewport.Y * 0.66,
            Config.MinHeight,
            Config.MaxHeight
        )

    elseif viewport.X <= 500 then
        width = math.clamp(
            viewport.X - 26,
            Config.MinWidth,
            Config.MaxWidth
        )

        height = math.clamp(
            viewport.Y * 0.64,
            Config.MinHeight,
            Config.MaxHeight
        )
    end

    return UDim2.fromOffset(width, height)
end

