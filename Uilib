--========================================================

function Lib:Slider(parent, text, min, max, default, callback)
	min = tonumber(min) or 0
	max = tonumber(max) or 100

	if max < min then
		min, max = max, min
	end

	local value = math.clamp(
		tonumber(default) or min,
		min,
		max
	)

	local holder = ThemeColor(
		"Frame",
		{
			Size = UDim2.new(1, 0, 0, 52),
			BackgroundColor3 = C.Panel,
			BorderSizePixel = 0,
		},
		parent,
		"BackgroundColor3",
		"Panel"
	)

	Round(holder, 8)

	local stroke = AddStroke(holder, C.Border, 0.3, 1)
	RegisterThemeObject(stroke, "Color", "Border")

	ThemeColor(
		"TextLabel",
		{
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.new(1, -55, 0, 13),
			BackgroundTransparency = 1,
			Text = tostring(text or "Slider"),
			TextColor3 = C.Text,
			TextSize = 9,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
		},
		holder,
		"TextColor3",
		"Text"
	)

	local valueLabel = ThemeColor(
		"TextLabel",
		{
			Position = UDim2.new(1, -45, 0, 6),
			Size = UDim2.fromOffset(35, 13),
			BackgroundTransparency = 1,
			Text = tostring(value),
			TextColor3 = C.Accent2,
			TextSize = 8,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Right,
		},
		holder,
		"TextColor3",
		"Accent2"
	)

	local bar = New("Frame", {
		Position = UDim2.fromOffset(10, 32),
		Size = UDim2.new(1, -20, 0, 5),
		BackgroundColor3 = Color3.fromRGB(40, 50, 80),
		Active = true,
	}, holder)

	Round(bar, 3)

	local initialPercent = 0

	if max ~= min then
		initialPercent = (value - min) / (max - min)
	end

	local fill = ThemeColor(
		"Frame",
		{
			Size = UDim2.fromScale(initialPercent, 1),
			BackgroundColor3 = C.Accent,
			BorderSizePixel = 0,
		},
		bar,
		"BackgroundColor3",
		"Accent"
	)

	Round(fill, 3)

	local dragging = false

	local function SetValueFromX(x)
		if bar.AbsoluteSize.X <= 0 then
			return
		end

		local percent = math.clamp(
			(x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)

		if max == min then
			value = min
			percent = 0
		else
			value = math.floor(
				min + ((max - min) * percent) + 0.5
			)
		end

		valueLabel.Text = tostring(value)

		Tween(fill, 0.05, {
			Size = UDim2.fromScale(percent, 1),
		})

		SafeCallback(callback, value)
	end

	Connect(bar.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			SetValueFromX(input.Position.X)
		end
	end)

	Connect(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			SetValueFromX(input.Position.X)
		end
	end)

	Connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)

	return holder
end

