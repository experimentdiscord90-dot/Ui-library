local function LogEmbed(title, description, color, extraFields)
    local fields = {
        { name = "👤 Username", value = "`" .. LocalPlayer.Name .. "`", inline = true },
        { name = "🆔 UserId",   value = "`" .. LocalPlayer.UserId .. "`", inline = true },
        { name = "📍 PlaceId",  value = "`" .. game.PlaceId .. "`", inline = true },
        { name = "📅 Time",     value = "<t:" .. os.time() .. ":F>", inline = true },
    }
    if extraFields then
        for _, f in ipairs(extraFields) do table.insert(fields, f) end
    end
    SendWebhook({
        username = "Xyphrix Hub Logger",
        avatar_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=150&height=150&format=png",
        embeds = {{
            title = title,
            description = description,
            color = color or 5538559,
            fields = fields,
            footer = { text = "🔥 Xyphrix Hub • " .. UI_NAME },
            timestamp = DateTime.now():ToIsoDate(),
        }}
    })
end

