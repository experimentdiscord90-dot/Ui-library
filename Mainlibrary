local function MakeRainbowGradient(offset)
    offset = offset or 0
    local keypoints = {}
    local segments = 6
    for i = 0, segments do
        local t = i / segments
        local hue = (t + offset) % 1
        table.insert(keypoints, ColorSequenceKeypoint.new(t, Color3.fromHSV(hue, 1, 1)))
    end
    return ColorSequence.new(keypoints)
end

